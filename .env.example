# Neo4j（ローカル Docker。AuraDB の場合は neo4j+s://xxxx.databases.neo4j.io とそのパスワード）
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=maintenance-demo
NEO4J_DATABASE=neo4j

# Gemini（Vertex AI 経由。`gcloud auth application-default login` 済みであること）
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=empirical-vial-510800-i7
GOOGLE_CLOUD_LOCATION=global
# AI Studio の API キーで代用する場合は上の 3 行を消して次を設定
# GOOGLE_API_KEY=

AGENT_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
